# ==============================================================================
# ZenithenOpen Environment Configuration Template
# NOTE: Never commit production values or real secrets to version control.
# Copy this file to `.env` or `.env.local` for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL + Prisma)
# Purpose: Connection string for the relational database storing users, projects,
# mentorship requests, achievements, and community metrics.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zenithen_open?schema=public"

# ------------------------------------------------------------------------------
# 2. Authentication (Auth.js / NextAuth)
# Purpose: Secret key used to encrypt session tokens and JWT cookies.
# Generate a secure string: `openssl rand -base64 32` or `npx auth secret`
# ------------------------------------------------------------------------------
AUTH_SECRET="development-auth-secret-change-in-production-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. GitHub OAuth & REST/GraphQL Integration (Octokit)
# Purpose: Enables GitHub SSO login, pulls repository stats, syncs PRs,
# identifies contributors, and manages good-first-issues.
# Register an OAuth app at https://github.com/settings/developers
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID="your_github_oauth_client_id"
GITHUB_CLIENT_SECRET="your_github_oauth_client_secret"
# GitHub Personal Access Token (PAT) for backend syncing without user rate limits
GITHUB_TOKEN="ghp_your_github_personal_access_token_for_org_sync"

# ------------------------------------------------------------------------------
# 4. Cache & Rate Limiting (Upstash Redis)
# Purpose: Caching GitHub API responses to prevent rate limiting (5000 req/hr)
# and storing hot metrics & session lookups.
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token"

# ------------------------------------------------------------------------------
# 5. Error Monitoring & Observability (Sentry)
# Purpose: Captures unhandled client/server exceptions in production.
# ------------------------------------------------------------------------------
SENTRY_DSN=""

# ------------------------------------------------------------------------------
# 6. Product Analytics (PostHog)
# Purpose: Privacy-friendly telemetry, pageviews, and community funnel analysis.
# ------------------------------------------------------------------------------
POSTHOG_KEY=""
POSTHOG_HOST="https://us.i.posthog.com"
